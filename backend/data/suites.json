            "status": "pass"
          },
          {
            "id": "s3",
            "description": "等待 2 秒",
            "expected": "结果页完成加载",
            "actual": "等待 2.0 秒",
            "status": "pass"
          },
          {
            "id": "s4",
            "description": "验证 页面 包含 Playwright",
            "expected": "结果页正文包含 Playwright",
            "actual": "✗ 页面未找到「Playwright」",
            "status": "fail"
          },
          {
            "id": "s5",
            "description": "截图 baidu_result",
            "expected": "已保存结果页截图",
            "actual": "截图已保存: baidu_result_20260428_150318.png",
            "status": "pass"
          }
        ]
      },
